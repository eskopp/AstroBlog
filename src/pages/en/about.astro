---
import BaseLayout from "astro-blog-theme/layouts/BaseLayout.astro";

const alternates = [
  { locale: "de", href: "/about/" },
  { locale: "en", href: "/en/about/" },
];
---

<BaseLayout
  locale="en"
  title="About"
  description="About Erik Skopp."
  alternates={alternates}
>
  <article class="prose">
    <h1>About</h1>
    <p>
      I run a small fleet of servers and write the occasional note about keeping
      them alive. This blog is built with Astro on top of
      <a href="https://github.com/eskopp/AstroBlogTheme">AstroBlogTheme</a>.
    </p>
    <p>
      Find me on <a href="https://github.com/eskopp">GitHub</a>.
    </p>
  </article>
</BaseLayout>
