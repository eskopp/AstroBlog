---
import BaseLayout from "astro-blog-theme/layouts/BaseLayout.astro";

const alternates = [
  { locale: "de", href: "/impressum/" },
  { locale: "en", href: "/en/impressum/" },
];
---

<BaseLayout
  locale="en"
  title="Legal Notice"
  description="Legal notice for erik-skopp.de."
  alternates={alternates}
>
  <article class="prose">
    <h1>Legal Notice</h1>

    <p>
      This is a private, non-commercial blog. No services are offered for
      payment, there is no advertising and there are no affiliate links.
    </p>

    <h2>Operator</h2>
    <p>Erik Skopp</p>

    <h2>Liability for content</h2>
    <p>
      The contents of these pages were created with the greatest possible care.
      However, no guarantee can be given for the accuracy, completeness or
      timeliness of the content. I am responsible for my own content on these
      pages under general law. I will remove any content promptly once I become
      aware of a legal violation.
    </p>

    <h2>Liability for links</h2>
    <p>
      This site contains links to external third-party websites over whose
      content I have no control. The respective provider or operator is always
      responsible for the content of the linked pages. I will remove such links
      promptly once I become aware of a legal violation.
    </p>

    <h2>Copyright</h2>
    <p>
      Unless stated otherwise, the content of this blog is published under the
      <a href="https://creativecommons.org/licenses/by-nd/4.0/deed.en">
        CC BY-ND 4.0</a> licence. Contributions by third parties are marked as
      such.
    </p>
  </article>
</BaseLayout>
